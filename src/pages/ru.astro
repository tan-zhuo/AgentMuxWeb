---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';

const meta = {
  "title": "AgentMux — настольная панель управления ИИ-агентами для кода",
  "description": "AgentMux — панель управления ИИ-агентами для написания кода: Claude Code, Codex, Gemini CLI, Grok CLI, Aider и другие, на удалённых хостах и на этом компьютере. Сессии живут в tmux, многопанельная стена терминалов, рассылка с подтверждениями доставки и локальная оркестрация с обязательным одобрением человека. Помимо десктопа есть headless-режим serve и автономное приложение для Android, так что iPad и планшеты на Android тоже работают. Один бинарный файл, без сервера, лицензия MIT.",
  "keywords": "AgentMux, ИИ-агент, Claude Code, Codex, Gemini CLI, Grok CLI, Aider, tmux, SSH, удалённая разработка, управление агентами, панель управления, приложение для Android, iPad, планшет, телефон, headless-сервер, открытый исходный код",
  "ogTitle": "AgentMux — настольная панель управления ИИ-агентами для кода",
  "ogDescription": "Управляйте агентами для написания кода на сборочных серверах, GPU-машинах, staging-хостах и на этом компьютере. Сессии переживают обрывы связи по самой своей конструкции. Теперь и с iPad, планшетов и телефонов на Android — с автономным приложением, несущим собственное ядро. Один бинарный файл, лицензия MIT.",
  "ogType": "website"
};

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "AgentMux",
    "description": "Панель управления ИИ-агентами для написания кода: Claude Code, Codex, Gemini CLI, Grok CLI, Aider и другие на удалённых хостах и на этом компьютере, с сессиями, живущими в tmux. Десктоп, headless-режим serve и автономное приложение для Android. Один бинарный файл, без сервера.",
    "url": "https://agentmux.pro/ru.html",
    "inLanguage": "ru",
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "macOS 11+, Windows 10+, Linux, Android 8+, iPadOS (browser)",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "license": "https://github.com/tan-zhuo/AgentMux/blob/main/LICENSE",
    "downloadUrl": "https://github.com/tan-zhuo/AgentMux/releases/latest",
    "author": {
      "@type": "Person",
      "name": "tan-zhuo",
      "url": "https://tanzhuo.xyz"
    },
    "softwareHelp": {
      "@type": "CreativeWork",
      "url": "https://agentmux.pro/docs-ru.html"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "inLanguage": "ru",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Решает ли AgentMux, что делают мои агенты?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Нет. Цели, промпты и соглашения репозитория остаются за вами. Оркестратор изучает ситуацию и предлагает действия; любая операция, изменяющая хост, выполняется только после вашего явного одобрения."
        }
      },
      {
        "@type": "Question",
        "name": "Что требуется от хостов?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Удалённым Unix-подобным хостам (Linux / macOS) нужны POSIX-оболочка, tmux и SSH; удалённому Windows-хосту достаточно OpenSSH Server — сессии ведёт демон AgentMux. Локально напрямую подходят Linux и macOS, а Windows предлагает хосты WSL и нативный PowerShell."
        }
      },
      {
        "@type": "Question",
        "name": "Обязателен ли Ollama?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Нет. Ollama нужен только локальной оркестрации и семантическому поиску по памяти. Без него всё остальное полностью работоспособно."
        }
      },
      {
        "@type": "Question",
        "name": "Может ли AgentMux учитывать или ограничивать расходы агентов на модели?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Нет — и это сознательное решение. Трафик агента идёт напрямую с хоста к провайдеру. AgentMux его не проксирует и не читает ключи."
        }
      },
      {
        "@type": "Question",
        "name": "Рассчитан ли он на команды?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Один оператор на установку. Состояние, учётные данные и журнал решений хранятся на рабочей станции — без общего сервера, командного аккаунта и центрального хранилища аудита."
        }
      },
      {
        "@type": "Question",
        "name": "Останавливает ли удаление чего-либо в AgentMux работу на удалённом хосте?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Никогда. Удаление рабочей области или записи агента убирает только локальную запись — сессия tmux продолжает работать. Единственный элемент управления, уничтожающий работающую сессию, называется Kill, и он сначала запрашивает подтверждение."
        }
      },
      {
        "@type": "Question",
        "name": "Можно ли пользоваться AgentMux на планшете или телефоне?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Да. Тот же бинарник работает в headless-режиме serve (отдельная сборка agentmux-server-linux-amd64/arm64 или десктопная сборка с ключом --serve). Откройте в браузере планшета http://хост:8642, один раз введите токен доступа — и доступны все возможности; добавление на экран «Домой» превращает это в отдельное приложение. На Android можно также установить agentmux-android.apk: он несёт полное ядро внутри, SSH идёт прямо с устройства, и постоянно включённая машина не требуется."
        }
      },
      {
        "@type": "Question",
        "name": "Чем приложение для Android отличается от режима serve?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "В режиме serve ядро работает на одной из ваших машин, а планшеты и телефоны выступают клиентами и видят одно и то же состояние. APK для Android встраивает ядро в устройство и поддерживает его foreground-сервисом; конфигурация и ключи хранятся локально, зависимости от постоянно включённой машины нет."
        }
      }
    ]
  }
];
---

<Base lang="ru" kind="landing" title={meta.title} description={meta.description} keywords={meta.keywords} ogTitle={meta.ogTitle} ogDescription={meta.ogDescription} ogType={meta.ogType} jsonLd={jsonLd}>

<!-- ============================== hero ============================== -->
<header class="hero" id="top">
  <div class="hero-backdrop" aria-hidden="true"></div>
  <div class="hero-grid-lines" aria-hidden="true"></div>
  <div class="hero-inner">
    <a class="hero-badge" href="#mobile"><span class="tag">NEW</span> Приложение для Android и поддержка iPad уже здесь<span class="arrow">→</span></a>
    <h1>Настольная панель управления<br><span class="accent">ИИ-агентами для кода</span></h1>
    <p class="hero-sub">
      Управляйте Claude Code, Codex, Gemini CLI, Grok CLI, Aider и другими агентами — на сборочных
      серверах, GPU-машинах, staging-хостах и на этом компьютере. Каждый агент работает в сессии <b>tmux</b> на своём
      хосте: закройте клиент, отправьте ноутбук в сон, потеряйте сеть — работа продолжится. Теперь и с планшета
      или телефона.
    </p>
    <div class="hero-ctas">
      <a class="btn btn-primary" href="#download">Скачать бесплатно<span class="arrow">→</span></a>
      <a class="btn btn-ghost" href="https://github.com/tan-zhuo/AgentMux" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 16 16" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
        Исходный код
      </a>
    </div>

    <div class="showcase">
      <div class="showcase-glow" aria-hidden="true"></div>
      <div class="showcase-grid">
        <div class="term term-fleet">
          <div class="term-bar">
            <span class="term-dot"></span><span class="term-dot"></span><span class="term-dot"></span>
            <span class="term-title">обзор парка</span>
          </div>
          <div class="term-body">
            <div class="tree-sect">ПРОЕКТЫ</div>
            <div class="tree-line"><span class="ind">▾</span><span class="name">orbit-api</span><span class="meta">2 агента</span></div>
            <div class="tree-line"><span class="ind">&nbsp;├</span><span class="st st-on"></span><span class="name">claude-code</span><span class="meta">gpu-01</span></div>
            <div class="tree-line"><span class="ind">&nbsp;└</span><span class="st st-on"></span><span class="name">codex</span><span class="meta">dev-box</span></div>
            <div class="tree-line"><span class="ind">▾</span><span class="name">novel-reader</span><span class="meta">3 агента</span></div>
            <div class="tree-line"><span class="ind">&nbsp;├</span><span class="st st-on"></span><span class="name">aider</span><span class="meta">local</span></div>
            <div class="tree-line"><span class="ind">&nbsp;├</span><span class="st st-idle"></span><span class="name">gemini-cli</span><span class="meta">staging</span></div>
            <div class="tree-line"><span class="ind">&nbsp;└</span><span class="st st-off"></span><span class="name">opencode</span><span class="meta">простаивает</span></div>
            <div class="tree-sect" style="margin-top:14px">СЕРВЕРЫ</div>
            <div class="tree-line"><span class="st st-on"></span><span class="name">gpu-01</span><span class="meta">cpu 34% · gpu 81%</span></div>
            <div class="tree-line"><span class="st st-on"></span><span class="name">dev-box</span><span class="meta">cpu 12% · mem 7.2G</span></div>
            <div class="tree-line"><span class="st st-on"></span><span class="name">этот компьютер</span><span class="meta">tmux · без sshd</span></div>
          </div>
        </div>
        <div class="term">
          <div class="term-bar">
            <span class="term-dot"></span><span class="term-dot"></span><span class="term-dot"></span>
            <span class="term-title">agentmux — события</span>
          </div>
          <div class="term-body" data-log>
            <div class="log-line"><span class="log-tag tag-info">SSH</span><span class="log-text"><b>gpu-01</b> подключён · ключ хоста закреплён</span></div>
            <div class="log-line"><span class="log-tag tag-info">TMUX</span><span class="log-text"><b>claude-code</b> переподключён · история вывода на месте</span></div>
            <div class="log-line"><span class="log-tag tag-ok">RECV</span><span class="log-text">рассылка доставлена <b>5/5</b> · подтверждения получены</span></div>
            <div class="log-line"><span class="log-tag tag-hold">HOLD</span><span class="log-text">оркестратор предлагает <b>перезапустить агента</b> · ждёт одобрения</span></div>
            <div class="log-line"><span class="log-tag tag-info">MEM</span><span class="log-text">3 совпадения в памяти · эмбеддинги посчитаны локально</span></div>
            <div class="log-line"><span class="log-tag tag-ok">OK</span><span class="log-text">парк готов · хостов: <b>3</b> · агентов запущено: <b>7</b></span></div>
            <div class="tmux-bar"><span>[agentmux/0:fleet*]</span><span>3 хоста · 20:10 · ⌃K</span></div>
          </div>
        </div>
      </div>
    </div>

    <div class="stats-row">
      <div class="stat-cell"><span class="stat-num">7</span><span class="stat-label">агентских CLI поддержаны из коробки</span></div>
      <div class="stat-cell"><span class="stat-num">1</span><span class="stat-label">бинарник: десктоп · headless-сервер · приложение для Android</span></div>
      <div class="stat-cell"><span class="stat-num">3×3</span><span class="stat-label">стена терминалов, несколько хостов на одном экране</span></div>
      <div class="stat-cell"><span class="stat-num">MIT</span><span class="stat-label">100% открытый исходный код</span></div>
    </div>
  </div>
</header>

<!-- ============================== ecosystem marquee ============================== -->
<section class="eco">
  <div class="section-head reveal" style="margin-bottom:0">
    <span class="kicker">Экосистема</span>
    <h2 class="section-title">Работает с агентами и инфраструктурой, которые у вас уже есть</h2>
  </div>
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      <span class="marquee-item hot">Claude Code</span>
      <span class="marquee-item hot">Codex</span>
      <span class="marquee-item hot">Gemini CLI</span>
      <span class="marquee-item hot">OpenCode</span>
      <span class="marquee-item hot">Aider</span>
      <span class="marquee-item hot">Cursor CLI</span>
      <span class="marquee-item hot">Grok CLI</span>
      <span class="marquee-item">tmux</span>
      <span class="marquee-item">SSH</span>
      <span class="marquee-item">SFTP</span>
      <span class="marquee-item">SQLite</span>
      <span class="marquee-item">Ollama</span>
      <span class="marquee-item">WSL</span>
      <span class="marquee-item">macOS</span>
      <span class="marquee-item">Linux</span>
      <span class="marquee-item">Windows</span>
      <span class="marquee-item">Android</span>
      <span class="marquee-item">iPadOS</span>
      <span class="marquee-item">Docker</span>
      <span class="marquee-item">Телеметрия NVIDIA GPU</span>
      <span class="marquee-item">AES-256-GCM</span>
      <span class="marquee-item hot">Claude Code</span>
      <span class="marquee-item hot">Codex</span>
      <span class="marquee-item hot">Gemini CLI</span>
      <span class="marquee-item hot">OpenCode</span>
      <span class="marquee-item hot">Aider</span>
      <span class="marquee-item hot">Cursor CLI</span>
      <span class="marquee-item hot">Grok CLI</span>
      <span class="marquee-item">tmux</span>
      <span class="marquee-item">SSH</span>
      <span class="marquee-item">SFTP</span>
      <span class="marquee-item">SQLite</span>
      <span class="marquee-item">Ollama</span>
      <span class="marquee-item">WSL</span>
      <span class="marquee-item">macOS</span>
      <span class="marquee-item">Linux</span>
      <span class="marquee-item">Windows</span>
      <span class="marquee-item">Android</span>
      <span class="marquee-item">iPadOS</span>
      <span class="marquee-item">Docker</span>
      <span class="marquee-item">Телеметрия NVIDIA GPU</span>
      <span class="marquee-item">AES-256-GCM</span>
    </div>
  </div>
</section>

<!-- ============================== capabilities ============================== -->
<section class="section-pad" id="capabilities">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="kicker">Возможности</span>
      <h2 class="section-title">Всё необходимое для управления парком агентов</h2>
      <p class="section-desc">
        AgentMux никогда не владеет процессом агента — он подключается к сессии tmux на хосте.
        Живучесть сессий гарантирована самой конструкцией, а не тем, что клиент остаётся в сети.
      </p>
    </div>
    <div class="cap-grid">
      <article class="cap-card reveal">
        <div class="cap-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/></svg></div>
        <h3>Живучесть сессий</h3>
        <p>Закройте клиент, отправьте ноутбук в сон, потеряйте сеть — агенты продолжат работать. Откройте приложение снова — и вы в той же панели, история вывода на месте. Четырёхчасовая миграция больше не зависит от одного непрерывного SSH-соединения.</p>
      </article>
      <article class="cap-card reveal">
        <div class="cap-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4" width="19" height="16" rx="2.5"/><path d="m7 9 3 3-3 3"/><path d="M12.5 15H17"/></svg></div>
        <h3>Прямой доступ к терминалу</h3>
        <p>Панель каждого агента — полноценный терминал с цветом, поддержкой мыши, выделением и поиском, а не просмотр стенограммы. Вмешайтесь посреди задачи, поправьте агента и верните ему управление, не перезапуская работу.</p>
      </article>
      <article class="cap-card reveal">
        <div class="cap-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2.5"/><path d="M3 9.5h18M3 15h18M9.5 3v18M15 9.5V21"/></svg></div>
        <h3>Стена терминалов</h3>
        <p>Разделите область терминала на девять панелей — стена 3×3 с разными хостами, каждая панель интерактивна независимо. Перетаскивайте разделители, дважды щёлкните вкладку для увеличения — раскладка подстраивается под окно и восстанавливается при следующем запуске.</p>
      </article>
      <article class="cap-card reveal">
        <div class="cap-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4.9 19.1a10 10 0 0 1 0-14.2M8.5 15.5a5 5 0 0 1 0-7M19.1 4.9a10 10 0 0 1 0 14.2M15.5 8.5a5 5 0 0 1 0 7"/><circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none"/></svg></div>
        <h3>Рассылка с подтверждениями</h3>
        <p>Отправьте одну инструкцию любой выборке агентов; каждый вернёт квитанцию, подтверждающую доставку. Рассылка по всему парку становится проверяемой, а не предполагаемой.</p>
      </article>
      <article class="cap-card reveal">
        <div class="cap-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.8 4.5 5.6v5.2c0 4.6 3.1 8.4 7.5 9.9 4.4-1.5 7.5-5.3 7.5-9.9V5.6L12 2.8Z"/><path d="m8.8 11.6 2.3 2.3 4.1-4.4"/></svg></div>
        <h3>Оркестрация под контролем</h3>
        <p>Локальная модель, работающая через Ollama, может взять цель — например, выяснить, почему агент застрял, — и двигаться к ней по одному вызову инструмента за раз. Каждая изменяющая операция ждёт вашего явного одобрения; плановые обходы строго ограничены чтением.</p>
      </article>
      <article class="cap-card reveal">
        <div class="cap-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5.5" rx="7.5" ry="3"/><path d="M4.5 5.5v13c0 1.66 3.36 3 7.5 3s7.5-1.34 7.5-3v-13"/><path d="M4.5 12c0 1.66 3.36 3 7.5 3s7.5-1.34 7.5-3"/></svg></div>
        <h3>Поисковая память — только локально</h3>
        <p>Факты о проектах, предпочтения и активность агентов индексируются для поиска по формулировке или по смыслу. Эмбеддинги вычисляются локально; ничего не покидает машину. Учётные данные, совпадающие с известными шаблонами, вымарываются до сохранения.</p>
      </article>
      <article class="cap-card reveal">
