    <h2 class="section-title">Works with the agents and infrastructure you already run</h2>
  </div>
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      <span class="marquee-item hot">Claude Code</span>
      <span class="marquee-item hot">Codex</span>
