---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';

const meta = {
  "title": "AgentMux — A Desktop Control Plane for AI Coding Agents",
  "description": "AgentMux is a desktop control plane for AI coding agents — Claude Code, Codex, Gemini CLI, Aider, and more — on remote hosts and this one. tmux-backed session persistence, a multi-pane terminal wall, broadcast with delivery receipts, and human-approved local orchestration. One binary, no server, MIT licensed.",
  "keywords": "AgentMux, AI agent, Claude Code, Codex, Gemini CLI, Aider, tmux, SSH, remote development, agent management, desktop control plane, open source",
  "ogTitle": "AgentMux — A Desktop Control Plane for AI Coding Agents",
  "ogDescription": "Operate your coding agents on build servers, GPU boxes, staging hosts, and this computer. Sessions survive disconnects by construction. One binary, MIT licensed.",
  "ogType": "website"
};

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "AgentMux",
    "description": "A desktop control plane for AI coding agents: operate Claude Code, Codex, Gemini CLI, Aider, and more on remote hosts and this computer, with tmux-backed session persistence. One binary, no server.",
    "url": "https://agentmux.pro/en.html",
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "macOS 11+, Windows 10+, Linux",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "license": "https://github.com/tan-zhuo/AgentMux/blob/main/LICENSE",
    "downloadUrl": "https://github.com/tan-zhuo/AgentMux/releases/latest",
    "author": {
      "@type": "Person",
      "name": "tan-zhuo",
      "url": "https://tanzhuo.xyz"
    },
    "softwareHelp": {
      "@type": "CreativeWork",
      "url": "https://agentmux.pro/docs-en.html"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Does AgentMux decide what my agents do?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. Objectives, prompts, and repository conventions remain yours. The orchestrator investigates and proposes; any action that modifies a host executes only after your explicit approval."
        }
      },
      {
        "@type": "Question",
        "name": "What do hosts need?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Remote hosts need a POSIX shell, tmux, and SSH (AgentMux can install tmux where missing). This computer qualifies directly on Linux and macOS; on Windows there are two local hosts — WSL and native PowerShell, with native sessions persisted by a built-in session daemon."
        }
      },
      {
        "@type": "Question",
        "name": "Is Ollama required?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. Only local orchestration and semantic memory search need Ollama. Without it, everything else is fully functional."
        }
      },
      {
        "@type": "Question",
        "name": "Can it report or cap my agents' model spend?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No — deliberately. Agent traffic goes straight from the host to the provider. AgentMux does not proxy it and does not read the keys."
        }
      },
      {
        "@type": "Question",
        "name": "Is it built for teams?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "One operator per installation. State, credentials, and the decision log live on the workstation — no shared server, no team account, no central audit sink."
        }
      },
      {
        "@type": "Question",
        "name": "Does deleting something in AgentMux stop remote work?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Never. Removing a workspace or agent record only removes the local record — the tmux session keeps running. The one control that destroys a running session is named Kill, and it confirms first."
        }
      }
    ]
  }
];
---

<Base lang="en" kind="landing" title={meta.title} description={meta.description} keywords={meta.keywords} ogTitle={meta.ogTitle} ogDescription={meta.ogDescription} ogType={meta.ogType} jsonLd={jsonLd}>

<!-- ============================== hero ============================== -->
<header class="hero" id="top">
  <div class="hero-backdrop" aria-hidden="true"></div>
  <div class="hero-grid-lines" aria-hidden="true"></div>
  <div class="hero-inner">
    <h1>A Desktop Control Plane<br>for <span class="accent">AI Coding Agents</span></h1>
    <p class="hero-sub">
      Operate Claude Code, Codex, Gemini CLI, Aider, and more — on build servers, GPU boxes,
      staging hosts, and this computer. Every agent runs inside a <b>tmux</b> session on its host:
      close the client, suspend the laptop, lose the network — work continues.
    </p>
    <div class="hero-ctas">
      <a class="btn btn-primary" href="#download">Download Free<span class="arrow">→</span></a>
      <a class="btn btn-ghost" href="https://github.com/tan-zhuo/AgentMux" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 16 16" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
        View Source
      </a>
    </div>

    <div class="showcase">
      <div class="showcase-glow" aria-hidden="true"></div>
      <div class="showcase-grid">
        <div class="term term-fleet">
          <div class="term-bar">
            <span class="term-dot"></span><span class="term-dot"></span><span class="term-dot"></span>
            <span class="term-title">fleet overview</span>
          </div>
          <div class="term-body">
            <div class="tree-sect">PROJECTS</div>
            <div class="tree-line"><span class="ind">▾</span><span class="name">orbit-api</span><span class="meta">2 agents</span></div>
            <div class="tree-line"><span class="ind">&nbsp;├</span><span class="st st-on"></span><span class="name">claude-code</span><span class="meta">gpu-01</span></div>
            <div class="tree-line"><span class="ind">&nbsp;└</span><span class="st st-on"></span><span class="name">codex</span><span class="meta">dev-box</span></div>
            <div class="tree-line"><span class="ind">▾</span><span class="name">novel-reader</span><span class="meta">3 agents</span></div>
            <div class="tree-line"><span class="ind">&nbsp;├</span><span class="st st-on"></span><span class="name">aider</span><span class="meta">local</span></div>
            <div class="tree-line"><span class="ind">&nbsp;├</span><span class="st st-idle"></span><span class="name">gemini-cli</span><span class="meta">staging</span></div>
            <div class="tree-line"><span class="ind">&nbsp;└</span><span class="st st-off"></span><span class="name">opencode</span><span class="meta">idle</span></div>
            <div class="tree-sect" style="margin-top:14px">SERVERS</div>
            <div class="tree-line"><span class="st st-on"></span><span class="name">gpu-01</span><span class="meta">cpu 34% · gpu 81%</span></div>
            <div class="tree-line"><span class="st st-on"></span><span class="name">dev-box</span><span class="meta">cpu 12% · mem 7.2G</span></div>
            <div class="tree-line"><span class="st st-on"></span><span class="name">this computer</span><span class="meta">tmux · no sshd</span></div>
          </div>
        </div>
        <div class="term">
          <div class="term-bar">
            <span class="term-dot"></span><span class="term-dot"></span><span class="term-dot"></span>
            <span class="term-title">agentmux — activity</span>
          </div>
          <div class="term-body" data-log>
            <div class="log-line"><span class="log-tag tag-info">SSH</span><span class="log-text"><b>gpu-01</b> connected · host key pinned</span></div>
            <div class="log-line"><span class="log-tag tag-info">TMUX</span><span class="log-text"><b>claude-code</b> reattached · scrollback intact</span></div>
            <div class="log-line"><span class="log-tag tag-ok">RECV</span><span class="log-text">broadcast <b>5/5</b> delivered · receipts confirmed</span></div>
            <div class="log-line"><span class="log-tag tag-hold">HOLD</span><span class="log-text">orchestrator proposes <b>restart agent</b> · awaiting approval</span></div>
            <div class="log-line"><span class="log-tag tag-info">MEM</span><span class="log-text">3 memory hits · embeddings computed locally</span></div>
            <div class="log-line"><span class="log-tag tag-ok">OK</span><span class="log-text">fleet ready · <b>3</b> hosts · <b>7</b> agents running</span></div>
            <div class="tmux-bar"><span>[agentmux/0:fleet*]</span><span>3 hosts · 20:10 · ⌃K</span></div>
          </div>
        </div>
      </div>
    </div>

    <div class="stats-row">
      <div class="stat-cell"><span class="stat-num">6+</span><span class="stat-label">Mainstream agent CLIs supported</span></div>
      <div class="stat-cell"><span class="stat-num">1</span><span class="stat-label">Binary — no server, no daemon, no account</span></div>
      <div class="stat-cell"><span class="stat-num">3×3</span><span class="stat-label">Terminal wall across hosts, on one screen</span></div>
      <div class="stat-cell"><span class="stat-num">MIT</span><span class="stat-label">100% open source</span></div>
    </div>
  </div>
</header>

