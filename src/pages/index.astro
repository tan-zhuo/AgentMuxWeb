---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';

const meta = {
  "title": "AgentMux — AI 编程 Agent 的桌面控制平面",
  "description": "AgentMux 是面向远程主机与本机上 AI 编程 Agent（Claude Code、Codex、Gemini CLI、Grok CLI、Aider 等）的控制平面。基于 tmux 的会话持久化、多窗格终端墙、批量下发与回执、人工审批的本地编排。桌面之外还有无头 serve 模式与内嵌核心的安卓 App，iPad 与安卓平板浏览器即可使用。单一二进制，无服务端，MIT 开源。",
  "keywords": "AgentMux, AI Agent, Claude Code, Codex, Gemini CLI, Grok CLI, Aider, tmux, SSH, 远程开发, Agent 管理, 控制平面, 安卓 App, iPad, 平板, 手机, 无头服务, 开源",
  "ogTitle": "AgentMux — AI 编程 Agent 的桌面控制平面",
  "ogDescription": "在构建机、GPU 机、预发机和本机上运维你的编程 Agent。会话由 tmux 保障持久，断网合盖都不中断。现已支持 iPad、安卓平板与手机——安卓有内嵌核心的独立 App。单一二进制，MIT 开源。",
  "ogType": "website"
};

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "AgentMux",
    "description": "AI 编程 Agent 的控制平面：在远程主机与本机上运维 Claude Code、Codex、Gemini CLI、Grok CLI、Aider 等编程 Agent，基于 tmux 的会话持久化。桌面、无头 serve 模式与安卓 App 三种形态，单一二进制，无服务端。",
    "url": "https://agentmux.pro/",
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "macOS 11+, Windows 10+, Linux, Android 8+, iPadOS (browser)",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "license": "https://github.com/tan-zhuo/AgentMux/blob/main/LICENSE",
    "downloadUrl": "https://github.com/tan-zhuo/AgentMux/releases/latest",
    "author": {
      "@type": "Person",
      "name": "tan-zhuo",
      "url": "https://tanzhuo.xyz"
    },
    "softwareHelp": {
      "@type": "CreativeWork",
      "url": "https://agentmux.pro/docs.html"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "AgentMux 会决定我的 Agent 做什么吗？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "不会。目标、提示词与仓库约定始终归你。编排器只做调查和提案，任何会修改主机的动作都需要你显式审批后才会执行。"
        }
      },
      {
        "@type": "Question",
        "name": "主机需要满足什么条件？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "远程类 Unix 主机（Linux / macOS）需要 POSIX shell、tmux 与 SSH（缺 tmux 时 AgentMux 可以代装）；远程 Windows 主机启用 OpenSSH Server 即可，会话由 AgentMux 的守护进程托管。本机在 Linux / macOS 直接可用；Windows 上提供 WSL 与原生 PowerShell 两种本机主机。"
        }
      },
      {
        "@type": "Question",
        "name": "必须安装 Ollama 吗？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "不是。只有本地编排与记忆的语义检索需要 Ollama。不装它，应用的其余全部功能完整可用。"
        }
      },
      {
        "@type": "Question",
        "name": "能管控 Agent 的模型花费吗？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "不能，这是刻意的边界。Agent 的模型流量从主机直连各家服务商，AgentMux 不代理、也不读取 API Key。"
        }
      },
      {
        "@type": "Question",
        "name": "适合团队共用吗？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "每份安装服务一位操作者：状态、凭据与决策日志都在本工作站上，没有共享服务端、团队账号或集中审计。"
        }
      },
      {
        "@type": "Question",
        "name": "在 AgentMux 里删除东西，会停掉远程的工作吗？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "不会。删除工作区或 Agent 记录只是移除本地记录，tmux 会话继续运行。唯一会销毁运行中会话的操作叫 Kill，它会先确认。"
        }
      },
      {
        "@type": "Question",
        "name": "AgentMux 可以在平板或手机上用吗？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "可以。同一个二进制能以无头 serve 模式运行（专用服务器版 agentmux-server-linux-amd64/arm64，或桌面版加 --serve），平板浏览器打开 http://主机:8642 输入一次令牌即可使用全部功能，并可「添加到主屏幕」当独立 App。安卓还可以直接安装 agentmux-android.apk，它内嵌完整核心，SSH 从设备直接发起，不需要任何常开的机器。"
        }
      },
      {
        "@type": "Question",
        "name": "安卓 App 和 serve 模式有什么区别？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "serve 模式下核心运行在你的一台机器上，平板与手机作为客户端共享同一份状态；安卓 APK 把核心装进设备本身，由前台服务保活，配置与密钥存在设备本地，完全不依赖常开的机器。"
        }
      }
    ]
  }
];
---

<Base lang="zh" kind="landing" title={meta.title} description={meta.description} keywords={meta.keywords} ogTitle={meta.ogTitle} ogDescription={meta.ogDescription} ogType={meta.ogType} jsonLd={jsonLd}>

<!-- ============================== hero ============================== -->
<header class="hero" id="top">
  <div class="hero-backdrop" aria-hidden="true"></div>
  <div class="hero-grid-lines" aria-hidden="true"></div>
  <div class="hero-inner">
    <a class="hero-badge" href="#mobile"><span class="tag">NEW</span> 安卓 App 与 iPad 支持已上线<span class="arrow">→</span></a>
    <h1>AI 编程 Agent 的<br><span class="accent">桌面控制平面</span></h1>
    <p class="hero-sub">
      在构建机、GPU 机、预发机——以及本机上，运维 Claude Code、Codex、Gemini CLI、Grok CLI、Aider
      等编程 Agent。每个 Agent 跑在所属主机的 <b>tmux</b> 会话里：关闭客户端、合盖休眠、网络中断，
      工作照常进行。现在，平板与手机上也一样。
    </p>
    <div class="hero-ctas">
      <a class="btn btn-primary" href="#download">免费下载<span class="arrow">→</span></a>
      <a class="btn btn-ghost" href="https://github.com/tan-zhuo/AgentMux" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 16 16" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
        查看源码
      </a>
    </div>

    <div class="showcase">
      <div class="showcase-glow" aria-hidden="true"></div>
      <div class="showcase-grid">
        <div class="term term-fleet">
          <div class="term-bar">
            <span class="term-dot"></span><span class="term-dot"></span><span class="term-dot"></span>
            <span class="term-title">集群总览</span>
          </div>
          <div class="term-body">
            <div class="tree-sect">PROJECTS</div>
            <div class="tree-line"><span class="ind">▾</span><span class="name">orbit-api</span><span class="meta">2 agents</span></div>
            <div class="tree-line"><span class="ind">&nbsp;├</span><span class="st st-on"></span><span class="name">claude-code</span><span class="meta">gpu-01</span></div>
            <div class="tree-line"><span class="ind">&nbsp;└</span><span class="st st-on"></span><span class="name">codex</span><span class="meta">dev-box</span></div>
            <div class="tree-line"><span class="ind">▾</span><span class="name">novel-reader</span><span class="meta">3 agents</span></div>
            <div class="tree-line"><span class="ind">&nbsp;├</span><span class="st st-on"></span><span class="name">aider</span><span class="meta">本机</span></div>
            <div class="tree-line"><span class="ind">&nbsp;├</span><span class="st st-idle"></span><span class="name">gemini-cli</span><span class="meta">staging</span></div>
            <div class="tree-line"><span class="ind">&nbsp;└</span><span class="st st-off"></span><span class="name">opencode</span><span class="meta">idle</span></div>
            <div class="tree-sect" style="margin-top:14px">SERVERS</div>
            <div class="tree-line"><span class="st st-on"></span><span class="name">gpu-01</span><span class="meta">cpu 34% · gpu 81%</span></div>
            <div class="tree-line"><span class="st st-on"></span><span class="name">dev-box</span><span class="meta">cpu 12% · mem 7.2G</span></div>
            <div class="tree-line"><span class="st st-on"></span><span class="name">本机</span><span class="meta">tmux · 无需 sshd</span></div>
          </div>
        </div>
        <div class="term">
          <div class="term-bar">
            <span class="term-dot"></span><span class="term-dot"></span><span class="term-dot"></span>
            <span class="term-title">agentmux — 活动流</span>
          </div>
          <div class="term-body" data-log>
            <div class="log-line"><span class="log-tag tag-info">SSH</span><span class="log-text"><b>gpu-01</b> 连接建立 · 主机指纹已固定</span></div>
            <div class="log-line"><span class="log-tag tag-info">TMUX</span><span class="log-text"><b>claude-code</b> 重新附着 · 滚动缓冲完整保留</span></div>
            <div class="log-line"><span class="log-tag tag-ok">RECV</span><span class="log-text">批量下发 <b>5/5</b> 送达 · 回执已确认</span></div>
            <div class="log-line"><span class="log-tag tag-hold">HOLD</span><span class="log-text">编排器提案 <b>restart agent</b> · 等待人工审批</span></div>
            <div class="log-line"><span class="log-tag tag-info">MEM</span><span class="log-text">检索记忆命中 3 条 · embedding 本地生成</span></div>
            <div class="log-line"><span class="log-tag tag-ok">OK</span><span class="log-text">集群就绪 · <b>3</b> 台主机 · <b>7</b> 个 agent 在跑</span></div>
            <div class="tmux-bar"><span>[agentmux/0:fleet*]</span><span>3 hosts · 20:10 · ⌃K</span></div>
          </div>
        </div>
      </div>
    </div>

    <div class="stats-row">
      <div class="stat-cell"><span class="stat-num">7 种</span><span class="stat-label">开箱支持的主流 Agent CLI</span></div>
      <div class="stat-cell"><span class="stat-num">1 个</span><span class="stat-label">二进制：桌面 · 无头服务端 · 安卓 App</span></div>
      <div class="stat-cell"><span class="stat-num">3×3</span><span class="stat-label">终端窗格墙，多主机同屏操控</span></div>
      <div class="stat-cell"><span class="stat-num">MIT</span><span class="stat-label">100% 开源协议</span></div>
    </div>
  </div>
</header>

<!-- ============================== ecosystem marquee ============================== -->
<section class="eco">
  <div class="section-head reveal" style="margin-bottom:0">
    <span class="kicker">生态与依赖</span>
    <h2 class="section-title">接入你已经在用的 Agent 与基础设施</h2>
  </div>
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      <span class="marquee-item hot">Claude Code</span>
      <span class="marquee-item hot">Codex</span>
      <span class="marquee-item hot">Gemini CLI</span>
      <span class="marquee-item hot">OpenCode</span>
      <span class="marquee-item hot">Aider</span>
      <span class="marquee-item hot">Cursor CLI</span>
      <span class="marquee-item hot">Grok CLI</span>
      <span class="marquee-item">tmux</span>
      <span class="marquee-item">SSH</span>
      <span class="marquee-item">SFTP</span>
      <span class="marquee-item">SQLite</span>
      <span class="marquee-item">Ollama</span>
      <span class="marquee-item">WSL</span>
      <span class="marquee-item">macOS</span>
      <span class="marquee-item">Linux</span>
      <span class="marquee-item">Windows</span>
      <span class="marquee-item">Android</span>
      <span class="marquee-item">iPadOS</span>
      <span class="marquee-item">Docker</span>
      <span class="marquee-item">NVIDIA GPU 遥测</span>
      <span class="marquee-item">AES-256-GCM</span>
      <span class="marquee-item hot">Claude Code</span>
      <span class="marquee-item hot">Codex</span>
      <span class="marquee-item hot">Gemini CLI</span>
      <span class="marquee-item hot">OpenCode</span>
      <span class="marquee-item hot">Aider</span>
      <span class="marquee-item hot">Cursor CLI</span>
      <span class="marquee-item hot">Grok CLI</span>
      <span class="marquee-item">tmux</span>
      <span class="marquee-item">SSH</span>
      <span class="marquee-item">SFTP</span>
      <span class="marquee-item">SQLite</span>
      <span class="marquee-item">Ollama</span>
      <span class="marquee-item">WSL</span>
      <span class="marquee-item">macOS</span>
      <span class="marquee-item">Linux</span>
      <span class="marquee-item">Windows</span>
      <span class="marquee-item">Android</span>
      <span class="marquee-item">iPadOS</span>
      <span class="marquee-item">Docker</span>
      <span class="marquee-item">NVIDIA GPU 遥测</span>
      <span class="marquee-item">AES-256-GCM</span>
    </div>
  </div>
</section>

<!-- ============================== capabilities ============================== -->
<section class="section-pad" id="capabilities">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="kicker">核心能力</span>
      <h2 class="section-title">运维一支 Agent 舰队所需要的，都在这里</h2>
      <p class="section-desc">
        AgentMux 不持有 Agent 进程，而是连接到主机上的 tmux 会话——持久化由结构保证，
        而不是由客户端的在线状态保证。
      </p>
    </div>
    <div class="cap-grid">
      <article class="cap-card reveal">
        <div class="cap-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/></svg></div>
        <h3>会话持久化</h3>
        <p>断开客户端、休眠笔记本、网络中断——Agent 照跑不误。重新打开就连回同一个 pane，滚动缓冲区完整保留。四小时的迁移任务不再依赖一条 SSH 不断。</p>
      </article>
      <article class="cap-card reveal">
        <div class="cap-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4" width="19" height="16" rx="2.5"/><path d="m7 9 3 3-3 3"/><path d="M12.5 15H17"/></svg></div>
        <h3>直接的终端访问</h3>
        <p>每个 Agent 的 pane 是完整终端——颜色、鼠标、选中、搜索——而不是只读的会话记录。可以中途介入、纠正 Agent，再把控制权交回去，无需重启任务。</p>
      </article>
      <article class="cap-card reveal">
        <div class="cap-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2.5"/><path d="M3 9.5h18M3 15h18M9.5 3v18M15 9.5V21"/></svg></div>
        <h3>多会话终端墙</h3>
        <p>终端区最多拆成 3×3 九个窗格，跨主机同屏、各自独立操作。分隔缝可拖动，双击标签临时全屏，窗格布局随窗口宽度智能折行，下次启动自动恢复。</p>
      </article>
      <article class="cap-card reveal">
        <div class="cap-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4.9 19.1a10 10 0 0 1 0-14.2M8.5 15.5a5 5 0 0 1 0-7M19.1 4.9a10 10 0 0 1 0 14.2M15.5 8.5a5 5 0 0 1 0 7"/><circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none"/></svg></div>
        <h3>批量下发与送达回执</h3>
        <p>一条指令发给任意选中的 Agent，每个返回一张回执，确认是否真的送达。对集群的批量操作是可审计的，而不是假定成功。</p>
      </article>
      <article class="cap-card reveal">
        <div class="cap-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.8 4.5 5.6v5.2c0 4.6 3.1 8.4 7.5 9.9 4.4-1.5 7.5-5.3 7.5-9.9V5.6L12 2.8Z"/><path d="m8.8 11.6 2.3 2.3 4.1-4.4"/></svg></div>
        <h3>本地编排，人工审批</h3>
        <p>Ollama 本地模型可以接一个目标——比如查明某个 Agent 为何卡住——一次一个工具调用地推进。任何写操作都挂起等待你的显式审批，定时巡检严格只读。</p>
      </article>
      <article class="cap-card reveal">
        <div class="cap-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5.5" rx="7.5" ry="3"/><path d="M4.5 5.5v13c0 1.66 3.36 3 7.5 3s7.5-1.34 7.5-3v-13"/><path d="M4.5 12c0 1.66 3.36 3 7.5 3s7.5-1.34 7.5-3"/></svg></div>
        <h3>本地检索记忆</h3>
        <p>项目事实、偏好与 Agent 活动被索引，可按原文或语义检索。Embedding 本地生成，内容不出本机；命中已知模式的凭据在入库前自动脱敏。</p>
      </article>
      <article class="cap-card reveal">
        <div class="cap-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="11.5" height="18" rx="2"/><rect x="16.5" y="8.5" width="5" height="12.5" rx="1.5"/><path d="M7 18h3.5"/></svg></div>
        <h3>平板与手机随身接入<span class="new-tag">NEW</span></h3>
        <p>同一个二进制可以无头运行，平板浏览器打开就是完整的 AgentMux——终端、Agent、工具箱、文件浏览一个不少。安卓另有内嵌完整核心的独立 App：SSH 直接从设备发起，不依赖任何一台常开的机器。</p>
      </article>
      <article class="cap-card reveal">
        <div class="cap-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 9a6 6 0 1 0-12 0c0 5-2 6-2 6h16s-2-1-2-6"/><path d="M10.2 20a1.9 1.9 0 0 0 3.6 0"/></svg></div>
        <h3>需要人时它会举手<span class="new-tag">NEW</span></h3>
        <p>在提问、跑完等你看结果、还是闲在提示符前——过去在树上都只是「running」。现在轮询会读每个 pane 并分类，需要人介入的转变亮起标记，有人真的去看了才落下。</p>
      </article>
      <article class="cap-card reveal">
        <div class="cap-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20.5V8.5m0 0 4.5 4.5M12 8.5 7.5 13"/><path d="M4.5 4h15"/></svg></div>
        <h3>一键升级与整机迁移<span class="new-tag">NEW</span></h3>
        <p>启动后与每六小时检查一次新版：下载、校验 sha256、原地替换重启，失败自动回滚。整套配置也能加密成一个文件带去另一台电脑，导入永不覆盖已有条目。</p>
